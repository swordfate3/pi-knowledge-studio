{
  "name": "pi-knowledge-studio",
  "version": "0.1.0",
  "description": "A generic, provenance-aware multimodal knowledge workspace extension for Pi.",
  "keywords": [
    "pi-package",
    "pi",
    "knowledge-base",
    "rag",
    "multimodal",
    "documents"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "DECISIONS.md",
    "LICENSE",
    "config",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "dependencies": {
    "typebox": "^1.3.23"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "optionalDependencies": {
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
